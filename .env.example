# ============================================================
# 填写说明
# [你必须填写]：首次使用对应能力前必须替换，不能保留空值。
# [你按需填写]：启用模型/API 能力时再填；M1 本地 OCR 不需要。
# [已有默认值]：一般无需修改，只有目录或性能要求不同时才调整。
# 复制本文件为 .env 后填写；不要提交 .env。
# ============================================================

# ---------- 应用基础配置：[已有默认值] ----------
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_API_PREFIX=/api/v1

# ---------- Docker 配置：[已有默认值] ----------
# Linux 用户如果 UID/GID 不是 1000，请在 .env 中填写 `id -u`、`id -g` 的结果，
# 避免容器生成的 OCR 文件属于错误用户。macOS/Windows 通常无需修改。
LOCAL_UID=1000
LOCAL_GID=1000
APP_PORT=8000
APP_CPUS=4.0
APP_MEMORY_LIMIT=8g

# ---------- 数据目录：[已有默认值] ----------
# 原始 PDF 请由你放入 APP_STORAGE__RAW_DATA_DIR。
APP_STORAGE__SQLITE_PATH=data/knowledge.db
APP_STORAGE__SESSION_SQLITE_PATH=data/sessions.db
APP_STORAGE__INDEX_DIR=data/indexes
APP_STORAGE__RAW_DATA_DIR=data/raw
APP_STORAGE__PAGES_DIR=data/pages
APP_STORAGE__OCR_DIR=data/ocr
APP_STORAGE__PROCESSED_DIR=data/processed

# ---------- 模型配置：[你按需填写，M1 无需填写] ----------
# Chat 与 Embedding 可使用不同的 OpenAI-compatible 服务和密钥。
# EMBEDDING_MODEL 必须与构建索引时使用的模型一致。
APP_MODEL__PROVIDER=compatible
APP_MODEL__CHAT_BASE_URL=https://api.deepseek.com
APP_MODEL__CHAT_API_KEY_ENV=DEEPSEEK_API_KEY
APP_MODEL__CHAT_MODEL=
APP_MODEL__EMBEDDING_BASE_URL=
APP_MODEL__EMBEDDING_API_KEY_ENV=LLM_API_KEY
APP_MODEL__EMBEDDING_MODEL=
# 当前兼容服务实测建议批次 16；长表格只截断向量输入，证据原文不截断。
APP_MODEL__EMBEDDING_BATCH_SIZE=16
APP_MODEL__EMBEDDING_MAX_CHARS=6000
APP_MODEL__REQUEST_RETRIES=3

# 示例（不要在本文件写入真实密钥）：
# DEEPSEEK_API_KEY=your-deepseek-secret-key
# LLM_API_KEY=your-embedding-service-secret-key

# ---------- OCR 配置：[已有默认值] ----------
# APP_OCR__ENGINE 当前仅支持 rapidocr；运行前由你统一安装 requirements-ocr.txt。
APP_OCR__ENGINE=rapidocr
APP_OCR__LANGUAGE=ch
APP_OCR__DPI=300
APP_OCR__CONFIDENCE_THRESHOLD=0.6
APP_OCR__MIN_TEXT_CHARS=10
APP_OCR__IMAGE_FORMAT=png

# ---------- Agent 与检索配置：[已有默认值，M1 不使用] ----------
# RAG 模式还必须将下方 RAG_LLM_ENABLED 改为 true，并重新构建一次向量索引。
APP_RETRIEVAL__BM25_TOP_K=20
APP_RETRIEVAL__VECTOR_TOP_K=20
APP_RETRIEVAL__RERANK_TOP_K=5
APP_RETRIEVAL__CONTEXTUAL_ENABLED=true
APP_RETRIEVAL__CONTEXTUAL_STRATEGY=deterministic
APP_RETRIEVAL__CONTEXTUAL_VERSION=v1
APP_RETRIEVAL__RRF_K=60
APP_RETRIEVAL__EXACT_WEIGHT=2.0
APP_RETRIEVAL__BM25_WEIGHT=1.0
APP_RETRIEVAL__VECTOR_WEIGHT=0.25
APP_AGENT__MAX_CLARIFICATIONS=2
APP_AGENT__MAX_RETRIEVAL_RETRIES=2
APP_AGENT__MAX_CHECK_ITEMS=20
# [你按需填写] true：大模型必须调用 knowledge_search 后组织回答；false：离线抽取式回答。
APP_AGENT__RAG_LLM_ENABLED=false
